[settings]
os=Linux
arch=armv8
build_type=Release
compiler=gcc
compiler.cppstd=gnu20
compiler.libcxx=libstdc++11
compiler.version=12

[buildenv]
CROSS_COMPILE=ON
BUILD_FROM_SRC=ON
CC=/opt/toolchains/aarch64-none-linux-gnu-12.3/bin/aarch64-none-linux-gnu-gcc
CXX=/opt/toolchains/aarch64-none-linux-gnu-12.3/bin/aarch64-none-linux-gnu-g++
CMAKE_SYSROOT=/opt/sysroots/beagleplay
PKG_CONFIG_SYSROOT_DIR=/opt/sysroots/beagleplay
PKG_CONFIG_PATH=/opt/sysroots/beagleplay/usr/lib/pkgconfig

[options]
spdlog/*:build_examples=False
spdlog/*:build_tests=False
spdlog/*:header_only=True
spdlog/*:shared=False
spdlog/*:static=True

glfw/*:with_wayland=True
glfw/*:with_X11=True

[conf]
tools.system.package_manager:mode=disabled
tools.build:sysroot=/opt/sysroots/beagleplay
tools.cmake.cmaketoolchain:toolchain_file=cmake/beagleplay.cmake